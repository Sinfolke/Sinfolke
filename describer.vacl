candidate backend_developer {
    role {
        prefer backend_developer
        prefer python_developer
    }
    status {
        prefer junior
        never senior
    }
    languages {
        prefer python
        typescript
        javascript
    }

    environment {
        prefer linux,
        prefer ubuntu
        "windows"
    }

    tools {
        "PostgreSQL",
        "Django",
        prefer "fastAPI"
    }
    experience {
        never experience > 1.5
        prefer experience == 0
    }
    placement {
        prefer remote,
        poltava
    }
    salary {
        never < 20000,
        prefer >= 30000,
        prefer <= 50000
    }
}
candidate web_scrapper {
    role {
        require web_scrapper
    }
    status {
        prefer junior
        never senior
    }
    languages {
        python
        typescript
        javascript
    }

    environment {
        linux,
        ubuntu,
        "windows"
    }

    tools {
        "Playwright",
        prefer "Camoufox",
        "PostgreSQL",
    }
    experience {
        never experience > 1.5
        prefer experience == 0
    }
    placement {
        prefer remote,
        poltava
    }
    salary {
        never < 20000,
        prefer >= 30000,
        prefer <= 50000
    }
}
candidate cpp_software_developer {
    role {
        prefer any(
            system_developer,
            desktop_developer
        ),
        never Embedded
    }
    status {
        prefer junior
        never senior
    }
    languages {
        require cpp
    }

    environment {
        prefer linux,
        ubuntu weight 0.4,
        "windows"
    }

    tools {
        CMakefiles,
        Makefiles,
        prefer "vcpkg",
    }
    experience {
        never experience > 1.5
        prefer experience == 0
    }
    placement {
        prefer remote,
        poltava
    }
    salary {
        never < 20000,
        prefer >= 30000,
        prefer <= 50000
    }
}